# ==========================================
# NJ TOURS — Backend FastAPI Environment Variables Template
# ==========================================

# Application Metadata
PROJECT_NAME="NJ Tours API"
API_V1_STR="/api/v1"

# Production Secret Key (Generate a random 32-byte secret)
SECRET_KEY="replace_with_a_secure_random_production_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------
# Database Configuration (Choose Option A or Option B)
# ------------------------------------------

# Option A: Full Async MySQL Connection URL (aiomysql driver)
# Format: mysql+aiomysql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql+aiomysql://user:password@hosted-mysql-host.com:3306/nj_tours"

# Option B: Discrete MySQL Environment Variables (Recommended if passwords contain special characters)
# MYSQL_HOST="your-mysql-host.com"
# MYSQL_PORT=3306
# MYSQL_DATABASE="nj_tours"
# MYSQL_USER="your_db_username"
# MYSQL_PASSWORD="your_db_password"
# MYSQL_SSL=true

# ------------------------------------------
# CORS Security Configuration
# ------------------------------------------
# Comma-separated list of deployed frontend URLs allowed to access credentials and API
CORS_ORIGINS="https://nj-tours.vercel.app"

# ------------------------------------------
# Payment Gateway Configuration (Optional)
# ------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ------------------------------------------
# SMTP Email Notifications (Optional)
# ------------------------------------------
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True
