# ==========================================
# NJ TOURS — Frontend & Root Environment Template
# ==========================================

# Frontend API Base URL
# Leave blank (or use /api/v1) for Vercel unified Services deployment where both frontend & backend share the same domain.
# For independent frontend-backend deployment, provide your backend Vercel URL (e.g., https://nj-tours-backend.vercel.app/api/v1).
VITE_API_BASE_URL=

# WebSocket Live Telemetry Host (Optional)
# Vercel serverless does not maintain persistent WebSockets. Set only if using an external WebSocket server (e.g., AWS ALB/ECS).
# VITE_WS_URL=wss://api.yourdomain.com
